# Скопируйте в devtools/graphiti/.env (файл в .gitignore через корневой .env)

# LLM для извлечения сущностей Graphiti (по умолчанию OpenAI)
OPENAI_API_KEY=sk-...

# Neo4j (должно совпадать с docker-compose.graphiti.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphiti_dev_password

# Опционально: базовый путь репозитория для индексации
PROJECT_ROOT=../..
